#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

#define L_BASE      0
#define L_NUM       1
#define L_FUNC      2
#define L_SYM       3
#define L_WORK      4
#define L_MEDIA     5
#define L_EXTRAS    6
#define L_MOUSE     7
#define L_SLOW      8
#define L_SCROLL    9

#define D_KANA      LANG1
#define D_EN        LANG2


/*-------------------------------------------------------
* combos
-------------------------------------------------------*/
/ {
    combos {
        compatible = "zmk,combos";
        // g+hでCapsLock
        CapsWord {
            bindings = <&caps_word>;
            key-positions = <17 18>;
            layers = <L_BASE>;
        };

        // m+,でMiddleClic
        MiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <31 32>;
            layers = <L_MOUSE>;
        };
    };
};

/*-------------------------------------------------------
* macros
-------------------------------------------------------*/
/* " SPACE + 任意キー + SPACE " を作る共通マクロ */
#define WRAP_SYMBOL_MACRO(name, symbol_key) \
    name: name { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        bindings = \
            <&macro_tap>, <&kp SPACE>, \
            <&macro_tap>, <&kp symbol_key>, \
            <&macro_tap>, <&kp SPACE>; \
    };

/* 括弧系を量産する共通マクロ: "()" */
#define WRAP_PAIR_MACRO(name, left_key, right_key) \
    name: name { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        bindings = \
            <&macro_tap>, <&kp left_key>, \
            <&macro_tap>, <&kp right_key>, \
            <&macro_tap>, <&kp LEFT_ARROW>; \
    };

/ {
    macros {
        // バッククォート入力補助: `` + 左矢印（Markdownコードブロック用）
        grave_macro: grave_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;
        };

        WRAP_SYMBOL_MACRO(minus_macro,  MINUS) // " - "
        WRAP_SYMBOL_MACRO(equals_macro, EQUAL) // " = "
        WRAP_SYMBOL_MACRO(plus_macro,   PLUS)  // " + "
        WRAP_SYMBOL_MACRO(plus_colon,   COLON) // " : "

        WRAP_PAIR_MACRO(paren_pad_macro, LEFT_PARENTHESIS, RIGHT_PARENTHESIS) // ()
        WRAP_PAIR_MACRO(bracket_macro,   LEFT_BRACKET,     RIGHT_BRACKET)     // []
        WRAP_PAIR_MACRO(brace_macro,     LEFT_BRACE,       RIGHT_BRACE)       // {}
        WRAP_PAIR_MACRO(brace_sqt,       APOSTROPHE,       APOSTROPHE)        // ''
        WRAP_PAIR_MACRO(brace_dqt,       DQT,              DQT)               // ""

        // ホームディレクトリパス: "~/"（ファイルパス入力用）
        home_macro: home_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp TILDE>, <&macro_tap>, <&kp FSLH>;
        };
    };
};

/*-------------------------------------------------------
* behaviors
-------------------------------------------------------*/

/ {
    behaviors {
        // シングルタップとダブルタップを設定
        #define TAP_DANCE(name, single_tap, double_tap) \
            name: name { \
                compatible = "zmk,behavior-tap-dance"; \
                #binding-cells = <0>; \
                tapping-term-ms = <300>; \
                bindings = single_tap, double_tap; \
            }

        // ホームローモッド（基本）: キーを押し続けると修飾キー、タップすると通常キー
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; //
            tapping-term-ms = <120>; // この時間以上押し続けると修飾キーとして動作
            quick-tap-ms = <150>; // この時間内に再度タップすると常に通常キーとして動作
            require-prior-idle-ms = <185>; // 前のキーからこの時間以上経過している必要がある
            bindings = <&kp>, <&kp>;

            // hold, tap
        };

        // 2レイヤー切り替え: ホールドでモーメンタリ、タップでトグル
        httl: ht_two_layers {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&to>;
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <125>;
        };

        // スクロール/カーソル切り替え: ホールドでSCROLL、タップでSLOW（legacy td_cursor）
        td_cursor: td_scroll_or_cursor {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo L_SCROLL>, <&mo L_SLOW>;
        };

        // ベース/エクストラ切り替え: タップでレイヤー6、ダブルタップでレイヤー0
        td_bore: BASE_or_EXTRA {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&mo L_EXTRAS>, <&to L_BASE>;
        };

        /*-------------------------------------------------------
        * 記号入力補助
        -------------------------------------------------------*/
        // バッククォート拡張: タップでバッククォート、ダブルタップでマクロ
        td_grave: DoubleTap_Grave {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&grave_macro>;
        };

        // ハイフン拡張: タップでハイフン、ダブルタップでスペース付きハイフン
        td_hyphen: DoubleTap_Hyphen {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&minus_macro>;
        };

        // イコール拡張: タップでイコール、ダブルタップでスペース付きイコール
        td_equals: DoubleTap_Equals {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&equals_macro>;
        };

        // スラッシュ拡張: タップでスラッシュ、ダブルタップでホームディレクトリパス
        td_home: DoubleTap_Home {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&home_macro>;
        };

        /*-------------------------------------------------------
        * tap-dance
        -------------------------------------------------------*/
        TAP_DANCE(td_minus, <&kp MINUS>,<&minus_macro>);
        TAP_DANCE(td_equal, <&kp EQUAL>,<&equals_macro>);
        TAP_DANCE(td_plus,  <&kp PLUS>,  <&plus_macro>);
        TAP_DANCE(td_colon, <&kp COLON>,<&plus_colon>);

        TAP_DANCE(td_paren_pad, <&kp LEFT_PARENTHESIS>, <&paren_pad_macro>);
        TAP_DANCE(td_bracket,   <&kp LEFT_BRACKET>,     <&bracket_macro>);
        TAP_DANCE(td_brace,     <&kp LEFT_BRACE>,       <&brace_macro>);
        TAP_DANCE(td_sqt,       <&kp APOSTROPHE>,       <&brace_sqt>);
        TAP_DANCE(td_dqt,       <&kp DQT>,              <&brace_dqt>);
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
              &lt L_EXTRAS ESC &kp Q  &kp W  &kp E  &kp R          &kp T       &kp Y  &kp U  &kp I      &kp O       &kp P          &kp MINUS
              &hm LCTRL TAB    &kp A  &kp S  &kp D  &lt L_FUNC F   &kp G       &kp H  &kp J  &kp K      &kp L       &kp SEMICOLON  &kp APOSTROPHE
              &kp LEFT_SHIFT   &kp Z  &kp X  &kp C  &kp V          &kp B       &kp N  &kp M  &kp COMMA  &kp PERIOD  &kp FSLH       &lt L_WORK GRAVE

              &hm LALT  D_KANA     &lt L_NUM SPACE    &hm LGUI D_EN
              &lt L_SYM BACKSPACE  &lt L_MEDIA ENTER
            >;
        };

        NUM {
            bindings = <
              &trans  &none  &none  &none   &none          &none        &kp ASTRK    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS   &kp MINUS
              &trans  &none  &none  &none   &none          &none        &kp MINUS    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTRK  &kp SLASH
              &trans  &none  &none  &none   &kp BACKSPACE  &kp SPACE    &kp NUMBER_0 &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT    &td_equals

              &trans  &trans  &trans
              &trans  &trans
            >;
        };

        FUNCTION {
            bindings = <
              &trans  &none   &kp HOME  &kp UP_ARROW    &kp END    &none     &none   &kp F7  &kp F8  &kp F9  &kp F10  &kp F13
              &trans  &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &none     &none   &kp F4  &kp F5  &kp F6  &kp F11  &kp F14
              &trans  &none   &none     &none           &none      &none     &none   &kp F1  &kp F2  &kp F3  &kp F12  &kp F15

              &trans  &trans  &trans
              &trans  &trans
            >;
        };

        SYM {
            bindings = <
              &trans  &none  &none  &none   &none   &none     &none       &kp AMPS    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL
              &trans  &none  &none  &none   &trans  &none     &td_hyphen  &kp DOLLAR  &kp PERCENT   &kp CARET             &kp LEFT_BRACKET       &kp RIGHT_BRACKET
              &trans  &none  &none  &none   &none   &none     &none       &kp EXCL    &kp AT        &kp HASH              &kp SLASH              &kp BSLH

              &trans  &trans  &trans
              &trans  &trans
            >;
        };

        WORKSPACE {
            bindings = <
              &trans  &none  &none  &none  &none  &none     &none         &none        &none      &none          &kp LG(LEFT_BRACKET) &kp LG(RIGHT_BRACKET)
              &trans  &none  &none  &none  &none  &none     &kp RC(LEFT)  &kp RC(DOWN) &kp RC(UP) &kp RC(RIGHT)  &kp RS(LEFT_BRACKET) &kp RS(RIGHT_BRACKET)
              &trans  &none  &none  &none  &none  &td_minus &none         &kp RC(AT) &none          &none                &none

              &trans  &trans  &trans
              &trans  &trans
            >;
        };

        MEDIA {
            bindings = <
              &trans  &none  &none  &none  &none  &none     &none     &none     &none    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT
              &trans  &none  &none  &none  &none  &none     &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT       &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
              &trans  &none  &none  &none  &none  &none     &none     &kp F13   &kp F14  &none           &none              &kp K_MUTE

              &trans  &trans  &trans
              &trans  &trans
            >;
        };

        EXTRAS {
            bindings = <
              &to L_BASE       &none  &none  &none  &out OUT_BLE  &out OUT_USB    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &out OUT_TOG  &bt BT_CLR
              &kp C_SLEEP      &none  &none  &none  &none         &none           &none         &none         &none         &none         &none         &none
              &kp C_AL_COFFEE  &none  &none  &none  &none         &bootloader     &bootloader   &none         &none         &none         &none         &studio_unlock
              &none  &none  &none
              &none  &none
            >;
        };

        MOUSE {
            bindings = <
              &trans  &none   &none  &none  &none  &none        &none   &none      &none      &none       &none  &none
              &trans  &none   &none  &none  &none  &none        &none   &none      &none      &none       &none  &none
              &trans  &none   &none  &none  &none  &none        &none   &mkp LCLK  &mkp RCLK  &td_cursor  &none  &none

              &trans  &trans  &trans
              &trans  &trans
            >;
        };

        SLOW {
            bindings = <
              &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
              &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
              &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans

              &trans  &trans  &trans
              &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
              &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
              &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
              &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &kp RIGHT_SHIFT

              &trans  &trans  &trans
              &trans  &trans
            >;
        };
    };
};

/*
 * Auto mouse layer (AML) — Input Processor style (Zenn kot149)
 * zip_temp_layer is chained on &trackball_listener in charybdis_pointer.dtsi.
 */
&zip_temp_layer {
    excluded-positions = <
        31 32 33
        12 24 39
    >;
    require-prior-idle-ms = <200>;
};

&mkp_input_listener {
    input-processors = <&zip_temp_layer 7 5000>;
};
